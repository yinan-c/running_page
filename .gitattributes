# This is a fork kept for upstream's code, not its activity data. Upstream
# commits its own runs daily, so a plain `git merge upstream/master` would pull
# another athlete's activities back into this page. These paths always keep the
# local version on merge.
#
# The `keepmine` driver has to be registered once per clone (see
# docs/sync-upstream.md):
#
#   git config merge.keepmine.driver true
#
src/static/activities.json  merge=keepmine
run_page/data.db            merge=keepmine binary
imported.json               merge=keepmine
run_page/imported.json      merge=keepmine

# Generated by gen_svg.py from the local database.
assets/github*.svg          merge=keepmine
assets/grid*.svg            merge=keepmine
assets/year_*.svg           merge=keepmine

# Raw activity exports.
GPX_OUT/**                  merge=keepmine
TCX_OUT/**                  merge=keepmine
FIT_OUT/**                  merge=keepmine
Workouts/**                 merge=keepmine
activities/**               merge=keepmine
